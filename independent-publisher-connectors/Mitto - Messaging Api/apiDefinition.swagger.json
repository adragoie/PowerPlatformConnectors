        "responses": {
          "200": {
            "x-nullable": false,
            "description": "Traffic accounts list",
            "schema": {
              "type": "array",
              "items": {
                "type": "object",
                "description": "Traffic account model",
                "required": [
                  "id",
                  "isActive"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Traffic account ID",
                    "title": "Traffic account ID",
                    "example": "906b5d8f-2870-4290-8813-a975463f5525"
                  },
                  "messagingApplicationName": {
                    "type": "string",
                    "description": "Messaging application name",
                    "title": "Messaging application name",
                    "example": "WhatsApp"
                  },
                  "isActive": {
                    "type": "boolean",
                    "description": "True if active",
                    "title": "Is Active",
                    "example": true
                  },
                  "senderName": {
                    "type": "string",
                    "description": "Traffic account message sender name",
                    "title": "Sender Name",
                    "example": "Mitto"
                  },
                  "senderNumber": {
                    "type": "string",
                    "description": "Traffic account message sender number",
                    "title": "Sender Number",
                    "example": "0123456789"
                  }
                }
              }
            }
          }
        },
        "description": "Get all Traffic Accounts"
      }
