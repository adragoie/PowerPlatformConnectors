                      },
                      "description": "participants"
                    }
                  },
                  "description": "conversation"
                },
                "createdAt": {
                  "type": "string",
                  "description": "Created On",
                  "title": "Created On"
                },
                "updatedAt": {
                  "type": "string",
                  "description": "Modified On",
                  "title": "Modified On"
                },
                "trafficAccountId": {
                  "type": "string",
                  "description": "Traffic Account Id",
                  "title": "Traffic Account Id"
                },
                "deliveryStatus": {
                  "type": "string",
                  "description": "Delivery Status",
                  "title": "Delivery Status"
                },
                "description": {
                  "type": "string",
                  "description": "Description",
                  "title": "Description"
                }
              }
            }
          }          
        },
        "description": "Get Message details by Id"
      }
