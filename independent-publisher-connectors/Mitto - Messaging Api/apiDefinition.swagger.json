    "/api/v{version}/TrafficAccounts": {
      "get": {
        "tags": [
          "TrafficAccounts"
        ],
        "summary": "Get all Traffic Accounts",
        "operationId": "TrafficAccounts_Get",
        "parameters": [
          {
            "name": "version",
            "in": "path",
            "required": true,
