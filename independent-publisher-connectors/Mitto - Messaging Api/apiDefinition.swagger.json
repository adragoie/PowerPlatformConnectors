      "post": {
        "summary": "When a message is received, delivered, read or failed",
        "consumes": ["application/json"],
        "description": "When a message is received, delivered, read or failed",
        "operationId": "Messages_WhenAnEventIsReceived",
        "x-ms-trigger": "single",
        "parameters": [
          {
            "name": "version",
            "in": "path",
            "required": true,
            "x-nullable": true,
