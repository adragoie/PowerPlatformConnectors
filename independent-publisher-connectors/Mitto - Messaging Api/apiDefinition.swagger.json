{
  "swagger": "2.0",
  "info": {
    "title": "Mitto Messaging Chat",
    "version": "1.0.0",
    "description": "The Mitto Messaging API connector allows integration of Mitto's services into workflows to: \n- Send Chat messages. \n- Get Message Detail by Id. \n- Receive incoming message.\n- Monitor delivery, read, or error events.\n- Get the list of traffic accounts associated with the used API Key.",
    "contact": {
        "name": "Alessandro Drago",
        "email": "alessandro.drago@impresoftengage.com",
        "url": "https://www.impresoftengage.com/"
    }
  },
  "host": "messaging.mittoapi.com",
  "basePath": "/",
  "schemes": [
    "https"
  ],
  "consumes": [],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/api/v{version}/Messages/send": {
      "post": {
        "tags": [
          "Messages"
        ],
        "summary": "Send a single message",
        "operationId": "Messages_SendMessage",
        "consumes": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "version",
			"x-ms-summary": "API Version",
			"description": "The current version of the API.",
            "in": "path",
            "required": true,
            "type": "number",
            "default": 1.1,
            "x-ms-visibility": "advanced",
			"x-ms-url-encoding": "single"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "trafficAccountId": {
                  "type": "string",
                  "description": "The traffic account ID related to the sender",
                  "title": "Traffic Account ID"
                },
                "destination": {
                  "type": "string",
                  "description": "The phone number of the receiver",
                  "title": "Receiver"
                },
                "whatsApp": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "description": "The type of the message",
                      "title": "WhatsApp - Message type",
                      "enum": [
                        "Template",
                        "Regular",
                        "Inbound"
                      ]
                    },
                    "template": {
                      "x-ms-visibility": "advanced",
                      "type": "object",
                      "properties": {
                        "namespace": {
                          "type": "string",
                          "description": "Namespace of the template",
                          "title": "WhatsApp - Template - Namespace",
                          "x-ms-visibility": "advanced"
                        },
                        "name": {
                          "type": "string",
                          "description": "Name of the template",
                          "title": "WhatsApp - Template - Name"
                        },
                        "language": {
                          "type": "object",
                          "properties": {
                            "policy": {
                              "type": "string",
                              "description": "policy",
                              "title": "WhatsApp - Template - Language Policy",
                              "x-ms-visibility": "advanced"
                            },
                            "code": {
                              "type": "string",
                              "description": "The code of the language or locale to use (iso code Alpha-2 ISO 639-1)",
                              "title": "WhatsApp - Template - Language Code"
                            }
                          },
                          "description": "language"
                        },
                        "components": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "type": {
                                "type": "string",
                                "description": "Describes the component type",
                                "title": "WhatsApp - Template - Components Type",
                                "enum": [
                                  "header",
                                  "body"
                                ]
                              },
                              "parameters": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "type": {
                                      "type": "string",
                                      "description": "Describes the parameter type",
                                      "enum": [
                                        "text",
                                        "currency",
                                        "date_time",
                                        "image",
                                        "document",
                                        "video"
                                      ],
                                      "title": "WhatsApp - Template - Components Parameters Type"
                                    },
                                    "text": {
                                      "type": "string",
                                      "description": "Text content of the parameter(required if type is \"text\")",
                                      "title": "WhatsApp - Template - Components Parameters Type"
                                    },
                                    "image": {
                                      "type": "object",
                                      "properties": {
                                        "link": {
                                          "type": "string",
                                          "description": "Image URL",
                                          "title": "WhatsApp - Template - Components Parameters Image link"
                                        },
                                        "provider": {
                                          "type": "object",
                                          "properties": {
                                            "name": {
                                              "type": "string",
                                              "description": "Provider name",
                                              "title": "WhatsApp - Template - Components Parameters Image Provider Name"
                                            }
                                          },
                                          "description": "This path is optionally used with link when the HTTP/HTTPS link is not directly accessible and requires additional configurations like a bearer token",
                                          "x-ms-visibility": "advanced"
                                        }
                                      },
                                      "description": "Represents image object(required if type is \"image\")"
                                    },
                                    "video": {
                                      "type": "object",
                                      "properties": {
                                        "link": {
                                          "type": "string",
                                          "description": "Video URL",
                                          "title": "WhatsApp - Template - Components Parameters Video link"
                                        },
                                        "provider": {
                                          "type": "object",
                                          "properties": {
                                            "name": {
                                              "type": "string",
                                              "description": "Provider name",
                                              "title": "WhatsApp - Template - Components Parameters Video Provider Name"
                                            }
                                          },
                                          "description": "This path is optionally used with link when the HTTP/HTTPS link is not directly accessible and requires additional configurations like a bearer token",
                                          "x-ms-visibility": "advanced"
                                        }
                                      },
                                      "description": "Represents video object(required if type is \"video\")"
                                    },
                                    "document": {
                                      "type": "object",
                                      "properties": {
                                        "link": {
                                          "type": "string",
                                          "description": "Document URL",
                                          "title": "WhatsApp - Template - Components Parameters Document link"
                                        },
                                        "filename": {
                                          "type": "string",
                                          "description": "File name",
                                          "title": "WhatsApp - Template - Components Parameters Document filename"
                                        },
                                        "provider": {
                                          "type": "object",
                                          "properties": {
                                            "name": {
                                              "type": "string",
                                              "description": "Provider name",
                                              "title": "WhatsApp - Template - Components Parameters Document Provider Name"
                                            }
                                          },
                                          "description": "This path is optionally used with link when the HTTP/HTTPS link is not directly accessible and requires additional configurations like a bearer token",
                                          "x-ms-visibility": "advanced"
                                        }
                                      },
                                      "description": "Represents document object(required if type is \"document\")"
                                    },
                                    "currency": {
                                      "type": "object",
                                      "properties": {
                                        "fallback_value": {
                                          "type": "string",
                                          "description": "Fallback value",
                                          "title": "WhatsApp - Template - Components Parameters Currency - Fallback value"
                                        },
                                        "code": {
                                          "type": "string",
                                          "description": "Currency code (format ISO 4217)",
                                          "title": "WhatsApp - Template - Components Parameters Currency - code"
                                        },
                                        "amount_1000": {
                                          "type": "integer",
                                          "format": "int32",
                                          "description": "Amount",
                                          "title": "WhatsApp - Template - Components Parameters Currency - Amount"
                                        }
                                      },
                                      "description": "Represents currency object(required if type is \"currency\")"
                                    },
                                    "date_time": {
                                      "type": "object",
                                      "properties": {
                                        "fallback_value": {
                                          "type": "string",
                                          "description": "Fallback value",
                                          "title": "WhatsApp - Template - Components Parameters Date time - Fallback value"
                                        },
                                        "day_of_week": {
                                          "type": "integer",
                                          "format": "int32",
                                          "description": "Day of week",
                                          "title": "WhatsApp - Template - Components Parameters Date time - Day of week"
                                        },
                                        "day_of_month": {
                                          "type": "integer",
                                          "format": "int32",
                                          "description": "Day of month",
                                          "title": "WhatsApp - Template - Components Parameters Date time - Day of month"
                                        },
                                        "year": {
                                          "type": "integer",
                                          "format": "int32",
                                          "description": "year",
                                          "title": "WhatsApp - Template - Components Parameters Date time - year"
                                        },
                                        "month": {
                                          "type": "integer",
                                          "format": "int32",
                                          "description": "month",
                                          "title": "WhatsApp - Template - Components Parameters Date time - month"
                                        },
                                        "hour": {
                                          "type": "integer",
                                          "format": "int32",
                                          "description": "hour",
                                          "title": "WhatsApp - Template - Components Parameters Date time - hour"
                                        },
                                        "minutes": {
                                          "type": "integer",
                                          "format": "int32",
                                          "description": "minutes",
                                          "title": "WhatsApp - Template - Components Parameters Date time - minutes"
                                        },
                                        "timestamp": {
                                          "type": "integer",
                                          "format": "int32",
                                          "description": "timestamp",
                                          "title": "WhatsApp - Template - Components Parameters Date time - timestamp"
                                        }
                                      },
                                      "description": "Represents dateTime object(required if type is \"date_time\")"
                                    }
                                  }
                                },
                                "description": "parameters"
                              }
                            }
                          },
                          "description": "Array containing the parameters of the message"
                        }
                      },
                      "description": "template"
                    },
                    "regular": {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "description": "Regular message content type",
                          "title": "WhatsApp - Regular - Content Type",
                          "enum": [
                            "Text",
                            "Image",
                            "File",
                            "Location"
                          ]
                        },
                        "text": {
                          "type": "string",
                          "description": "Text content of the message (required if message type is \"text\")",
                          "title": "WhatsApp - Regular - Text"
                        },
                        "mediaUrl": {
                          "x-ms-visibility": "advanced",
                          "type": "string",
                          "description": "URL used for the message (required if message type is \"file\" or \"image\")",
                          "title": "WhatsApp - Regular - Media URL"
                        },
                        "coordinates": {
                          "x-ms-visibility": "advanced",
                          "type": "object",
                          "properties": {
                            "lat": {
                              "type": "number",
                              "format": "float",
                              "description": "Floating point value representing the latitude of the location",
                              "title": "WhatsApp - Regular - Coordinates - Latitude"
                            },
                            "long": {
                              "type": "number",
                              "format": "float",
                              "description": "Floating point value representing the longitude  of the location",
                              "title": "WhatsApp - Regular - Coordinates - longitude"
                            }
                          },
                          "description": "Coordinates of the location(required if message type is \"location\")"
                        },
                        "location": {
                          "x-ms-visibility": "advanced",
                          "type": "object",
                          "properties": {
                            "address": {
                              "type": "string",
                              "description": "String representing the address of the location",
                              "title": "WhatsApp - Regular - Location - address"
                            },
                            "name": {
                              "type": "string",
                              "description": "String representing the name of the location",
                              "title": "WhatsApp - Regular - Location - name"
                            }
                          },
                          "description": "Information about the location"
                        }
                      },
                      "description": "regular"
                    }
                  },
                  "description": "WhatsApp object (required if TrafficAccount has WhatsApp messaging application)"
                }
              },
              "required": [
                "destination",
                "trafficAccountId"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "x-nullable": false,
            "description": "Message response",
            "schema": {
              "type": "object",
              "properties": {
                "messageId": {
                  "type": "string",
                  "description": "Message Id",
                  "title": "Message Id"
                },
                "conversation": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Conversation ID",
                      "title": "Conversation ID"
                    }
                  },
                  "description": "conversation"
                },
                "createdAt": {
                  "type": "string",
                  "description": "Created On",
                  "title": "Created On"
                },
                "updatedAt": {
                  "type": "string",
                  "description": "Modified On",
                  "title": "Modified On"
                },
                "deliveryStatus": {
                  "type": "string",
                  "description": "Delivery Status",
                  "title": "Delivery Status"
                }
              }
            }
          }          
        },
        "description": "Send a chat template for marketing or text message for customer service support"
      }
    },
    "/api/v{version}/Messages/{Message Id}": {
      "get": {
        "tags": [
